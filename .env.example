# Speech backend (TamilHackathon) — local dev
# Copy to .env (backend repo) or set VITE_SPEECH_API_URL (frontend).
# NEVER commit the real .env.

# ElevenLabs — STT (Scribe v3) + TTS (Eleven v3)
ELEVENLABS_API_KEY=sk_your_key_here

# Premade voice stand-ins (swap for Tamil-native voices from the Voice Library)
VOICE_NARRATOR=
VOICE_CUSTOMS_OFFICER=
VOICE_TAXI_DRIVER=
VOICE_ELDER_HOST=
VOICE_COUSIN=
VOICE_WAITER=
VOICE_SHOPKEEPER=

# Frontend → speech backend. Local dev default:
#   VITE_SPEECH_API_URL=http://localhost:8787
# On Lovable, set it to the deployed edge function:
#   VITE_SPEECH_API_URL=https://<project-ref>.supabase.co/functions/v1/speech
